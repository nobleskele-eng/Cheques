{
  "permissions": {
    "allow": [
      "Bash(python3 -I research/scripts/pull_account.py:*)",
      "Bash(python3 -I research/scripts/proven_sounds.py:*)",
      "Bash(python3 -I research/scripts/watch.py:*)",
      "Bash(python3 research/model/success_model.py:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/master-size.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
